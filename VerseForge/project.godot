; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="VerseForge"
run/main_scene="res://scenes/main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="VerseForge"
config/features=PackedStringArray("4.5", "Forward Plus")
run/max_fps=60
run/low_processor_mode=true
run/delta_smoothing=false
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
boot_splash/image="uid://cmp0wmj8l14vu"
config/icon="uid://cmp0wmj8l14vu"

[audio]

driver/enable_input=true

[autoload]

global="*res://scripts/main_window/Global.gd"

[display]

window/size/viewport_width=256
window/size/viewport_height=256
window/size/initial_position_type=4
window/size/borderless=true
window/size/always_on_top=true
window/subwindows/embed_subwindows=false
window/vsync/vsync_mode=0

[editor]

movie_writer/fps=30

[editor_plugins]

enabled=PackedStringArray()

